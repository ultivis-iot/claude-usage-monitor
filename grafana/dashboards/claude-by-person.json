{
  "uid": "claude-by-person",
  "title": "Claude / By Person",
  "tags": ["claude"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "timezone": "browser",
  "time": { "from": "now-7d", "to": "now" },
  "links": [
    { "title": "📊 Overview", "type": "link", "url": "/d/claude-overview", "icon": "dashboard" },
    { "title": "👤 By Account", "type": "link", "url": "/d/claude-by-account", "icon": "dashboard" }
  ],
  "templating": {
    "list": [
      {
        "name": "member",
        "label": "멤버",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": { "query": "label_values(claude_code_token_usage_tokens_total, member)", "refId": "var-member" },
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": {}
      },
      {
        "name": "host",
        "label": "머신",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": { "query": "label_values(claude_code_token_usage_tokens_total{member=~\"$member\"}, host_name)", "refId": "var-host" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "최근 7일 토큰",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "sum(increase(claude_code_token_usage_tokens_total{member=~\"$member\", host_name=~\"$host\"}[7d]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 1 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "최근 7일 비용 (USD)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total{member=~\"$member\", host_name=~\"$host\"}[7d]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "모델별 토큰 (최근 7일)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_token_usage_tokens_total{member=~\"$member\", host_name=~\"$host\"}[7d]))",
          "legendFormat": "{{model}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "어느 Claude 계정으로 쓰나 (tokens/h) — 계정 전환 이력이 여기서 보임",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "sum by (user_email) (rate(claude_code_token_usage_tokens_total{member=~\"$member\", host_name=~\"$host\"}[10m])) * 3600",
          "legendFormat": "{{user_email}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "머신별 사용 (tokens/h) — 윈도우/리눅스 분해",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "sum by (host_name, os_user) (rate(claude_code_token_usage_tokens_total{member=~\"$member\", host_name=~\"$host\"}[10m])) * 3600",
          "legendFormat": "{{host_name}} ({{os_user}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "세션별 토큰 (최근 24시간)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "sort_desc(sum by (session_id, host_name, user_email) (increase(claude_code_token_usage_tokens_total{member=~\"$member\", host_name=~\"$host\"}[24h])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {}
    }
  ]
}
