    {
      "id": 50,
      "type": "table",
      "title": "👥 사용자 현황 (사용자 ▸ 펼치기)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "sum by (member, user_email, host_name)(increase(claude_code_token_usage_tokens_total[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
