              "user_email": "계정",
              "host_name": "PC",
              "Value": "토큰"
            }
          }
        },
        {
          "id": "groupToNestedTable",
          "options": {
            "showSubframeHeaders": true,
            "fields": {
              "사용자": {
                "aggregations": [],
                "operation": "groupby"
              }
            }
          }
        }
