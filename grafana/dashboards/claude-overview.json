      "type": "table",
      "title": "⚠️ 경고 / 알림 (문제 있는 계정만 표시 · 없으면 정상)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "label_replace(last_over_time(claude_limit_utilization{window=\"seven_day\"}[45m]) >= 90, \"경고\", \"🔴 주간 한도 90%↑\", \"account\", \"(.+)\") or label_replace(last_over_time(claude_limit_utilization{window=\"five_hour\"}[45m]) >= 90, \"경고\", \"🟠 세션 한도 90%↑\", \"account\", \"(.+)\") or label_replace(last_over_time(claude_limit_up[45m]) == 0, \"경고\", \"⚫ 수집오류(미로그인)\", \"account\", \"(.+)\")",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
