    {
      "id": 30,
      "type": "table",
      "title": "⚠️ 경고 / 알림 (문제 있는 계정만 표시 · 없으면 정상)",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "label_replace(last_over_time(claude_limit_utilization{window=\"seven_day\"}[45m]) >= 90, \"경고\", \"🔴 주간 한도 90%↑\", \"account\", \"(.+)\") or label_replace(last_over_time(claude_limit_utilization{window=\"five_hour\"}[45m]) >= 90, \"경고\", \"🟠 세션 한도 90%↑\", \"account\", \"(.+)\") or label_replace(last_over_time(claude_limit_up[45m]) == 0, \"경고\", \"⚫ 수집오류(미로그인)\", \"account\", \"(.+)\")",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "window": true,
              "scope": true,
              "kind": true,
              "group": true
            },
            "indexByName": {
              "경고": 0,
              "account": 1,
              "Value": 2
            },
            "renameByName": {
              "account": "계정",
              "Value": "값"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "값"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "계정"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "이 계정 상세",
                    "url": "/d/claude-by-account?var-account=${__value.text}"
                  }
                ]
              }
            ]
