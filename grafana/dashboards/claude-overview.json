{
  "uid": "claude-overview",
  "title": "Claude / Overview",
  "tags": [
    "claude"
  ],
  "schemaVersion": 39,
  "version": 28,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "👤 By Account",
      "type": "link",
      "url": "/d/claude-by-account",
      "icon": "dashboard"
    },
    {
      "title": "💻 By Person",
      "type": "link",
      "url": "/d/claude-by-person",
      "icon": "dashboard"
    },
    {
      "title": "⚡ Efficiency",
      "type": "link",
      "url": "/d/claude-efficiency",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 10,
      "type": "table",
      "title": "🔑 계정 현황 (계정 ▸ 펼치기)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "(max by (account)(last_over_time(claude_limit_utilization{window=\"seven_day\"}[45m]))) * on(account) group_right() label_replace((sum by (user_email,member,host_name)(increase(claude_code_token_usage_tokens_total[$__range]) > bool 0), \"account\", \"$1\", \"user_email\", \"(.+)\") or (max by (account)(last_over_time(claude_limit_utilization{window=\"seven_day\"}[45m]))) unless on(account) label_replace((sum by (user_email,member,host_name)(increase(claude_code_token_usage_tokens_total[$__range]) > bool 0), \"account\", \"$1\", \"user_email\", \"(.+)\")",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "(max by (account)(last_over_time(claude_limit_utilization{window=\"seven_day_fable\"}[45m]))) * on(account) group_right() label_replace((sum by (user_email,member,host_name)(increase(claude_code_token_usage_tokens_total[$__range]) > bool 0), \"account\", \"$1\", \"user_email\", \"(.+)\") or (max by (account)(last_over_time(claude_limit_utilization{window=\"seven_day_fable\"}[45m]))) unless on(account) label_replace((sum by (user_email,member,host_name)(increase(claude_code_token_usage_tokens_total[$__range]) > bool 0), \"account\", \"$1\", \"user_email\", \"(.+)\")",
          "format": "table",
          "instant": true,
          "refId": "F"
        },
        {
          "expr": "(max by (account)(last_over_time(claude_limit_utilization{window=\"five_hour\"}[45m]))) * on(account) group_right() label_replace((sum by (user_email,member,host_name)(increase(claude_code_token_usage_tokens_total[$__range]) > bool 0), \"account\", \"$1\", \"user_email\", \"(.+)\") or (max by (account)(last_over_time(claude_limit_utilization{window=\"five_hour\"}[45m]))) unless on(account) label_replace((sum by (user_email,member,host_name)(increase(claude_code_token_usage_tokens_total[$__range]) > bool 0), \"account\", \"$1\", \"user_email\", \"(.+)\")",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "(max by (account)(last_over_time(claude_limit_resets_at{window=\"seven_day\"}[45m])) * 1000) * on(account) group_right() label_replace((sum by (user_email,member,host_name)(increase(claude_code_token_usage_tokens_total[$__range]) > bool 0), \"account\", \"$1\", \"user_email\", \"(.+)\") or (max by (account)(last_over_time(claude_limit_resets_at{window=\"seven_day\"}[45m])) * 1000) unless on(account) label_replace((sum by (user_email,member,host_name)(increase(claude_code_token_usage_tokens_total[$__range]) > bool 0), \"account\", \"$1\", \"user_email\", \"(.+)\")",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "label_replace(sum by (user_email,member,host_name)(increase(claude_code_token_usage_tokens_total[$__range]), \"account\", \"$1\", \"user_email\", \"(.+)\")",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "user_email": true,
              "__name__": true
            },
            "renameByName": {
              "account": "계정",
              "Value #A": "Weekly 사용%",
              "Value #F": "Fable 주간%",
              "Value #B": "세션(5h) 사용%",
              "Value #C": "Weekly 초기화",
              "member": "사용자",
              "host_name": "PC",
              "Value #D": "토큰"
            }
          }
        },
        {
          "id": "groupToNestedTable",
          "options": {
            "showSubframeHeaders": true,
            "fields": {
              "계정": {
                "aggregations": [],
                "operation": "groupby"
              }
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Weekly 사용%"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
