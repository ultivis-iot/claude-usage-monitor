    {
      "id": 21,
      "type": "table",
      "title": "🏆 24시간 소비 랭킹 (멤버 × PC × 계정)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (member, host_name, user_email) (increase(claude_code_token_usage_tokens_total[24h])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
